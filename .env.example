DJANGO_SETTINGS_MODULE=core.settings
SECRET_KEY=your-django-secret-key
DEBUG=True
# "web" lets the Stripe CLI container reach the app for local webhooks
ALLOWED_HOSTS=localhost,127.0.0.1,web

DB_NAME=ecommerce
DB_USER=ecommerce
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
DB_HOST=db
DB_PORT=3306

# Use django.core.mail.backends.console.EmailBackend to print emails to the logs locally
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-16-character-password-generated-from-google-app-passwords
RECIPIENT_EMAIL=recipient-email@example.com

STRIPE_PUBLIC_KEY=pk_test_*************
STRIPE_SECRET_KEY=sk_test_*************
# From the Stripe dashboard (Developers > Webhooks) or `stripe listen`; endpoint: /stripe/webhook/
STRIPE_WEBHOOK_SECRET=whsec_*************
# Local webhooks: set COMPOSE_PROFILES=stripe to run the Stripe CLI container, then put the
# secret from `docker compose run --rm stripe listen --print-secret` in STRIPE_WEBHOOK_SECRET.
# COMPOSE_PROFILES=stripe

ADMIN_USERNAME=example_username
ADMIN_EMAIL=example@gmail.com
ADMIN_PASSWORD=example_password

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Host ports exposed by docker compose
WEB_PORT=8085
FLOWER_PORT=5560

# Security (production). Comma-separated; defaults keep the current production domain.
CSRF_TRUSTED_ORIGINS=https://a1albanywholesale.com,https://www.a1albanywholesale.com
# The settings below only apply defaults when DEBUG is off; override if needed.
# SECURE_SSL_REDIRECT=False
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=3600
# SECURE_HSTS_INCLUDE_SUBDOMAINS=False
# SECURE_HSTS_PRELOAD=False
# SESSION_COOKIE_AGE=1209600
# DATA_UPLOAD_MAX_MEMORY_SIZE=5242880
# FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
# allauth: none | optional | mandatory
ACCOUNT_EMAIL_VERIFICATION=optional
