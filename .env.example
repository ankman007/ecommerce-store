DJANGO_SETTINGS_MODULE=core.settings
SECRET_KEY=your-django-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=ecommerce
DB_USER=ecommerce
DB_PASSWORD=change-me
DB_ROOT_PASSWORD=change-me-too
DB_HOST=db
DB_PORT=3306

# Use django.core.mail.backends.console.EmailBackend to print emails to the logs locally
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-16-character-password-generated-from-google-app-passwords
RECIPIENT_EMAIL=recipient-email@example.com

STRIPE_PUBLIC_KEY=pk_test_*************
STRIPE_SECRET_KEY=sk_test_*************

ADMIN_USERNAME=example_username
ADMIN_EMAIL=example@gmail.com
ADMIN_PASSWORD=example_password

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# Host ports exposed by docker compose
WEB_PORT=8085
FLOWER_PORT=5560
