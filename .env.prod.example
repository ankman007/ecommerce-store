# Production environment for docker-compose.prod.yml. Copy to .env.prod on the server,
# fill in every value, and keep it out of git (chmod 600). Placeholders only in this file.
# Check it with: docker compose --env-file .env.prod -f docker-compose.prod.yml run --rm migrate python manage.py check_env

# --- Django ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=shop.example.com,www.shop.example.com
CSRF_TRUSTED_ORIGINS=https://shop.example.com,https://www.shop.example.com
# TLS is terminated in front of nginx, which forwards X-Forwarded-Proto. Turn this on once
# https works end to end (Django then redirects any plain-http request).
SECURE_SSL_REDIRECT=True
# Start small; raise to 31536000 once you are sure every subdomain serves https.
SECURE_HSTS_SECONDS=3600
ACCOUNT_EMAIL_VERIFICATION=optional

# --- Database (the "db" service; these also create the MySQL database and user) ---
DB_NAME=ecommerce
DB_USER=ecommerce
DB_PASSWORD=replace-with-a-strong-password
DB_ROOT_PASSWORD=replace-with-another-strong-password
DB_HOST=db
DB_PORT=3306

# --- Celery / Redis ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
CELERY_CONCURRENCY=2

# --- Email (SMTP; EMAIL_HOST/EMAIL_PORT/EMAIL_USE_TLS default to Gmail, override if needed) ---
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST_USER=shop@example.com
EMAIL_HOST_PASSWORD=replace-with-an-app-password
RECIPIENT_EMAIL=owner@example.com
# Base URL for links in customer emails
SITE_URL=https://shop.example.com

# --- Stripe (live keys in production; all three from the same Stripe account and mode) ---
STRIPE_PUBLIC_KEY=pk_live_replace-me
STRIPE_SECRET_KEY=sk_live_replace-me
# Signing secret of the https://<your-domain>/stripe/webhook/ endpoint in the Stripe dashboard
STRIPE_WEBHOOK_SECRET=whsec_replace-me

# --- Gunicorn (deploy/gunicorn.conf.py) ---
WEB_CONCURRENCY=3
# GUNICORN_THREADS=1
# GUNICORN_TIMEOUT=60
# GUNICORN_MAX_REQUESTS=1000
# GUNICORN_MAX_REQUESTS_JITTER=100

# --- Compose ---
# Images; the deploy workflow overrides APP_IMAGE/NGINX_IMAGE with the tag it just built.
# APP_IMAGE=ghcr.io/<owner>/<repo>:sha-<commit>
# NGINX_IMAGE=ghcr.io/<owner>/<repo>-nginx:sha-<commit>
# Host port for nginx. With a host-level TLS proxy in front, bind it to localhost only:
# NGINX_HTTP_BIND=127.0.0.1
# NGINX_HTTP_PORT=8080
NGINX_HTTP_BIND=0.0.0.0
NGINX_HTTP_PORT=80
# Flower (only with --profile monitoring; always bound to 127.0.0.1)
# FLOWER_PORT=5555
# FLOWER_BASIC_AUTH=admin:replace-me
