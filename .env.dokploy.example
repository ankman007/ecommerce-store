# Paste into Dokploy -> your Compose app -> Environment, then replace the values.
# Set up for a server with no domain yet (plain HTTP on the server IP or a generated
# traefik.me host). See docs/DOKPLOY.md for switching to HTTPS later.

# --- Django ---
DEBUG=False
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=replace-with-a-long-random-string
# The Dokploy-generated host and/or your server IP, comma-separated, no scheme or port
ALLOWED_HOSTS=ecommerce-store-abc123.203.0.113.10.traefik.me,203.0.113.10
# Same hosts with the http:// scheme (https:// once you have TLS)
CSRF_TRUSTED_ORIGINS=http://ecommerce-store-abc123.203.0.113.10.traefik.me,http://203.0.113.10
# Base URL for links in customer emails
SITE_URL=http://ecommerce-store-abc123.203.0.113.10.traefik.me
LOG_LEVEL=INFO

# --- No TLS yet: these MUST stay off over plain HTTP or logins and forms will fail ---
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_SSL_REDIRECT=False
ACCOUNT_DEFAULT_HTTP_PROTOCOL=http

# --- Database (MySQL container in the same stack) ---
DB_NAME=ecommerce
DB_USER=ecommerce
DB_PASSWORD=replace-with-a-strong-password
DB_ROOT_PASSWORD=replace-with-another-strong-password
DB_HOST=db
# MySQL keeps the passwords from the deploy that first created its volume. Got
# "Access denied" after changing them and there's no real data yet? Raise this by one
# to start a fresh, empty database. Never raise it on a store with real orders.
# DB_VOLUME_VERSION=2
DB_PORT=3306

# --- Celery / Redis (Redis container in the same stack) ---
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# --- Stripe (test keys while testing) ---
STRIPE_PUBLIC_KEY=pk_test_replace
STRIPE_SECRET_KEY=sk_test_replace
# Stripe only sends webhooks to HTTPS URLs; leave empty until the site has HTTPS.
# Orders are still confirmed by the success page and a reconciliation job every 15 minutes.
STRIPE_WEBHOOK_SECRET=

# --- Email ---
# Console backend = emails are only printed to the logs. Switch to SMTP when ready:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST_USER=you@gmail.com
#   EMAIL_HOST_PASSWORD=your-16-character-app-password
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
RECIPIENT_EMAIL=owner@example.com

# --- First admin account (created on deploy if it doesn't exist yet) ---
ADMIN_USERNAME=admin
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
